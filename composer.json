{
    "name": "vdsina/php-sdk",
    "description": "Compact, dependency-free PHP SDK for the VDSina public API (userapi.vdsina.com).",
    "type": "library",
    "keywords": ["vdsina", "api", "sdk", "vps", "server", "dns", "client"],
    "homepage": "https://vdsina.com/tech/api",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Vdsina\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vdsina\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests examples -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "minimum-stability": "stable"
}
