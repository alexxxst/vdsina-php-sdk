{
    "name": "vdsina/php-sdk",
    "description": "Compact, dependency-free PHP SDK for the VDSina public API (userapi.vdsina.com).",
    "type": "library",
    "keywords": ["vdsina", "api", "sdk", "vps", "server", "dns", "client"],
    "homepage": "https://vdsina.com/tech/api",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Vdsina\\": "src/"
        }
    },
    "scripts": {
        "lint": "php -l src/Client.php && php -l src/ApiException.php"
    },
    "minimum-stability": "stable"
}
